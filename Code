                  key={inst.trigger}
                  onClick={() => handleAiQuery(inst.trigger)}
                  className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs rounded-md transition-colors border border-slate-700 flex items-center gap-1"
                >
                  <Stethoscope size={12} /> {inst.trigger}
                </button>
              ))}
            </div>
          </div>

        </div>

        {/* RIGHT COLUMN: Vitals, Charts, Missions */}
        <div className="lg:col-span-7 flex flex-col gap-6">
          
          {/* VITALS GRID */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            <VitalCard title="Heart Rate" value="98" unit="bpm" icon={Heart} status="warning" />
            <VitalCard title="Blood Pressure" value="118/75" unit="mmHg" icon={Activity} status="good" />
            <VitalCard title="Radiation" value="0.22" unit="mSv" icon={ShieldAlert} status="warning" />
            <VitalCard title="Bone Density" value="-1.2" unit="T-score" icon={Bone} status="critical" />
          </div>

          {/* CHARTS SECTION */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            {/* Heart Rate Trend */}
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-xl">
              <h2 className="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">Heart Rate Trend (7 Days)</h2>
              <div className="h-48 w-full">
                <ResponsiveContainer width="100%" height="100%">
                  <AreaChart data={healthTrendData}>
                    <defs>
                      <linearGradient id="colorHr" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="5%" stopColor="#f59e0b" stopOpacity={0.3}/>
                        <stop offset="95%" stopColor="#f59e0b" stopOpacity={0}/>
                      </linearGradient>
                    </defs>
                    <CartesianGrid strokeDasharray="3 3" stroke="#1e293b" vertical={false} />
                    <XAxis dataKey="day" stroke="#64748b" fontSize={12} tickLine={false} axisLine={false} />
                    <YAxis stroke="#64748b" fontSize={12} tickLine={false} axisLine={false} domain={['dataMin - 5', 'dataMax + 5']} />
                    <Tooltip 
                      contentStyle={{ backgroundColor: '#0f172a', borderColor: '#1e293b', color: '#e2e8f0' }}
                      itemStyle={{ color: '#f59e0b' }}
                    />
                    <Area type="monotone" dataKey="hr" stroke="#f59e0b" strokeWidth={2} fillOpacity={1} fill="url(#colorHr)" />
                  </AreaChart>
                </ResponsiveContainer>
              </div>
            </div>

            {/* Radiation & Sleep */}
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-xl">
              <h2 className="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">Env Risks & Sleep</h2>
              <div className="h-48 w-full">
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={healthTrendData}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#1e293b" vertical={false} />
                    <XAxis dataKey="day" stroke="#64748b" fontSize={12} tickLine={false} axisLine={false} />
                    <YAxis yAxisId="left" stroke="#64748b" fontSize={12} tickLine={false} axisLine={false} orientation="left" />
                    <YAxis yAxisId="right" stroke="#64748b" fontSize={12} tickLine={false} axisLine={false} orientation="right" />
                    <Tooltip 
                      contentStyle={{ backgroundColor: '#0f172a', borderColor: '#1e293b', color: '#e2e8f0' }}
                      cursor={{fill: '#1e293b', opacity: 0.4}}
                    />
                    <Bar yAxisId="left" dataKey="radiation" name="Rad (mSv)" fill="#ef4444" radius={[4, 4, 0, 0]} barSize={8} />
                    <Bar yAxisId="right" dataKey="sleep" name="Sleep (h)" fill="#3b82f6" radius={[4, 4, 0, 0]} barSize={8} />
                  </BarChart>
                </ResponsiveContainer>
              </div>
            </div>
            
          </div>

          {/* DAILY MISSIONS (GAMIFICATION) */}
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl flex-grow">
            <div className="flex justify-between items-end mb-4">
              <div>
                <h2 className="text-lg font-bold text-slate-100 flex items-center gap-2">
                  Daily Health Missions
                </h2>
                <p className="text-slate-400 text-sm">Complete protocols to maintain optimal flight readiness.</p>
              </div>
              <div className="text-right">
                <span className="text-2xl font-black text-cyan-400 font-mono">{Math.round(missionProgress)}%</span>
              </div>
            </div>
            
            {/* Progress Bar */}
            <div className="w-full bg-slate-800 rounded-full h-2.5 mb-6 overflow-hidden border border-slate-700">
              <div 
                className="bg-gradient-to-r from-cyan-500 to-blue-500 h-2.5 rounded-full transition-all duration-500 ease-out" 
                style={{ width: `${missionProgress}%` }}
              ></div>
            </div>

            {/* Task List */}
            <div className="space-y-3">
              {missions.map((mission) => (
                <div 
                  key={mission.id} 
                  onClick={() => toggleMission(mission.id)}
                  className={`flex items-center gap-4 p-3 rounded-lg border cursor-pointer transition-all duration-200 ${
                    mission.completed 
                      ? 'bg-emerald-950/20 border-emerald-900/30 opacity-75' 
                      : 'bg-slate-800/50 border-slate-700 hover:bg-slate-800'
                  }`}
                >
                  <button className={`flex-shrink-0 transition-colors ${mission.completed ? 'text-emerald-400' : 'text-slate-500 hover:text-cyan-400'}`}>
                    {mission.completed ? <CheckCircle2 size={24} /> : <Circle size={24} />}
                  </button>
                  <span className={`flex-grow font-medium ${mission.completed ? 'text-slate-400 line-through' : 'text-slate-200'}`}>
                    {mission.title}
                  </span>
                  {mission.category === 'muscles' && <Activity size={16} className="text-slate-600" />}
                  {mission.category === 'brain' && <Brain size={16} className="text-slate-600" />}
                  {mission.category === 'bones' && <Bone size={16} className="text-slate-600" />}
                  {mission.category === 'vitals' && <Droplets size={16} className="text-slate-600" />}
                </div>
              ))}
            </div>

            {missionProgress === 100 && (
              <div className="mt-6 p-3 bg-emerald-950/40 border border-emerald-500/30 rounded-lg text-emerald-400 text-sm font-mono flex items-center justify-center gap-2 animate-pulse">
                <CheckCircle2 size={16} /> ALL DAILY PROTOCOLS COMPLETE. EXCELLENT WORK, COMMANDER.
              </div>
            )}
          </div>

        </div>
      </div>
      
      <style dangerouslySetInnerHTML={{__html: `
        @keyframes scan {
          0% { top: 0%; opacity: 0; }
          10% { opacity: 1; }
          90% { opacity: 1; }
          100% { top: 100%; opacity: 0; }
        }
      `}} />
    </div>
  );
}
